# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
.next-runtime*/
.next-*.nosync/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel/
**/supabase/.temp/

# typescript
*.tsbuildinfo

# private workspace artifacts (Codex / Claude / Cursor / etc.)
.codex/
.claude/
.cursor/
.agents/
.aider*

# launch video workspace (Remotion) - local only, never pushed
/video/

# private project notes — not shipped publicly
/creed.md
/design.md
/docs.md

# disposable agent working documents
/disposable/

# legacy / accidental git working trees
.git.backup-*

# OS / editor cruft
*.log
.idea/
.vscode/
